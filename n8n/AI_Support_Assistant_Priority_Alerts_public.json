      "name": "Save Notification"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    t.id,\n    t.category,\n    t.priority,\n    t.message_text,\n    t.status\nFROM tickets AS t\nWHERE t.status = 'new'\n  AND t.priority IN ('high', 'critical')\n  AND NOT EXISTS (\n      SELECT 1\n      FROM ticket_notifications AS n\n      WHERE n.ticket_id = t.id\n  )\nORDER BY t.id ASC;",
        "options": {}
      },
