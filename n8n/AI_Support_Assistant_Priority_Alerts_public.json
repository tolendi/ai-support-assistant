        "query": "SELECT\n    t.id,\n    t.category,\n    t.priority,\n    t.message_text,\n    t.draft_reply,\n    t.status,\n    t.review_status,\n    t.created_at\nFROM tickets AS t\nWHERE t.review_status = 'pending_review'\n    AND t.status = 'new'\n    AND t.chat_id IS NOT NULL\n    AND NOT EXISTS (\n        SELECT 1\n        FROM ticket_notifications AS n\n        WHERE n.ticket_id = t.id\n    )\nORDER BY t.created_at ASC;",
